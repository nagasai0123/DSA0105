#include <iostream>
using namespace std;

class Person
{
protected:
    string name, address, phone;

public:
    void acceptPerson()
    {
        cout << "Enter name: ";
        cin >> name;

        cout << "Enter address: ";
        cin >> address;

        cout << "Enter phone: ";
        cin >> phone;
    }
};

class Employee : public Person
{
    int eno;
    string ename;

public:
    void accept()
    {
        cout << "\nEmployee Number: ";
        cin >> eno;

        cout << "Employee Name: ";
        cin >> ename;

        acceptPerson();
    }

    void display()
    {
        cout << "\nEmployee: " << ename;
        cout << "\nEmployee No: " << eno;
        cout << "\nAddress: " << address;
        cout << "\nPhone: " << phone << endl;
    }
};

class Manager : public Person
{
    string designation, department;
    float salary;

public:
    void accept()
    {
        cout << "\nDesignation: ";
        cin >> designation;

        cout << "Department: ";
        cin >> department;

        cout << "Basic Salary: ";
        cin >> salary;

        acceptPerson();
    }

    void display()
    {
        cout << "\nManager: " << name;
        cout << "\nDesignation: " << designation;
        cout << "\nDepartment: " << department;
        cout << "\nSalary: " << salary << endl;
    }

    float getSalary()
    {
        return salary;
    }
};

int main()
{
    int n;

    cout << "Enter number of employees/managers: ";
    cin >> n;

    Employee e[10];
    Manager m[10];

    for(int i = 0; i < n; i++)
    {
        cout << "\nEmployee " << i + 1;
        e[i].accept();
    }

    for(int i = 0; i < n; i++)
    {
        cout << "\nManager " << i + 1;
        m[i].accept();
    }

    cout << "\n--- Employees ---\n";
    for(int i = 0; i < n; i++)
        e[i].display();

    cout << "\n--- Managers ---\n";
    for(int i = 0; i < n; i++)
        m[i].display();

    int pos = 0;

    for(int i = 1; i < n; i++)
    {
        if(m[i].getSalary() > m[pos].getSalary())
            pos = i;
    }

    cout << "\nManager with Highest Salary:\n";
    m[pos].display();

    return 0;
}

