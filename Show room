#include <iostream>
using namespace std;

class ShowRoom
{
    string name;
    long mobno;
    double cost, dis, amount;

public:
    void input()
    {
        cout << "Enter customer name: ";
        cin >> name;

        cout << "Enter mobile number: ";
        cin >> mobno;

        cout << "Enter cost: ";
        cin >> cost;
    }

    void calculate()
    {
        if(cost <= 10000)
            dis = cost * 0.05;
        else if(cost <= 20000)
            dis = cost * 0.10;
        else if(cost <= 35000)
            dis = cost * 0.15;
        else
            dis = cost * 0.20;

        amount = cost - dis;
    }

    void display()
    {
        cout << "\nCustomer: " << name;
        cout << "\nMobile: " << mobno;
        cout << "\nAmount to be paid: " << amount;
    }
};

int main()
{
    ShowRoom s;
    s.input();
    s.calculate();
    s.display();

    return 0;
}

