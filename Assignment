// ============================================================
// 8. EMERGENCY CASE CLASS
// ============================================================

class EmergencyCase {
private:
    int caseId;
    int patientId;
    string problem;
    int priority;
    string status;
    int resourceId;

public:

    // Default constructor
    EmergencyCase() {
        caseId = 0;
        patientId = 0;
        problem = "Unknown";
        priority = 1;
        status = "Pending";
        resourceId = 0;
    }

    // Parameterized constructor
    EmergencyCase(int cid, int pid,
                  string p, int pri) {
        caseId = cid;
        patientId = pid;
        problem = p;
        priority = pri;
        status = "Pending";
        resourceId = 0;
    }

    // Copy constructor
    EmergencyCase(const EmergencyCase &e) {
        caseId = e.caseId;
        patientId = e.patientId;
        problem = e.problem;
        priority = e.priority;
        status = e.status;
        resourceId = e.resourceId;
    }

    // Operator overloading: compare priority
    bool operator>(const EmergencyCase &e) const {
        return priority > e.priority;
    }

    // Operator overloading: combine priorities
    EmergencyCase operator+(const EmergencyCase &e) const {
        EmergencyCase temp;

        temp.caseId = 0;
        temp.patientId = 0;
        temp.problem = "Combined Case";
        temp.priority = priority + e.priority;

        if (temp.priority > 5)
            temp.priority = 5;

        temp.status = "Pending";
        temp.resourceId = 0;

        return temp;
    }

    void input(int id) {

        caseId = id;

        cout << "\nEnter Patient ID: ";
        cin >> patientId;

        cout << "Enter Emergency Problem: ";
        cin.ignore();
        getline(cin, problem);

        cout << "Enter Priority (1-5): ";
        cin >> priority;

        if (priority < 1)
            priority = 1;

        if (priority > 5)
            priority = 5;

        status = "Pending";
        resourceId = 0;
    }

    void display() const {

        cout << left
             << setw(8) << caseId
             << setw(12) << patientId
             << setw(25) << problem
             << setw(10) << priority
             << setw(15) << status
             << setw(12) << resourceId
             << endl;
    }

    int getCaseId() const {
        return caseId;
    }

    int getPatientId() const {
        return patientId;
    }

    int getPriority() const {
        return priority;
    }

    int getResourceId() const {
        return resourceId;
    }

    void allocateResource(int id) {
        resourceId = id;
        status = "Allocated";
    }

    void closeCase() {
        status = "Completed";
    }

    string getStatus() const {
        return status;
    }
};


// ============================================================
// 9. HOSPITAL MANAGEMENT SYSTEM
// ============================================================

class HospitalSystem {

private:

    static int totalPatients;
    static int totalResources;
    static int activeCases;

    Patient patients[50];
    EmergencyCase cases[50];

    Resource *resources[50];

    int patientCount;
    int caseCount;
    int resourceCount;

public:

    HospitalSystem() {

        patientCount = 0;
        caseCount = 0;
        resourceCount = 0;

        for (int i = 0; i < 50; i++) {
            resources[i] = nullptr;
        }
    }

    // Destructor
    ~HospitalSystem() {

        for (int i = 0; i < resourceCount; i++) {
            delete resources[i];
        }

        cout << "\nSystem resources released successfully.\n";
    }


    // ========================================================
    // REGISTER PATIENT
    // ========================================================

    void registerPatient() {

        if (patientCount >= 50) {
            cout << "\nPatient storage is full!\n";
            return;
        }

        patients[patientCount].input();

        patientCount++;
        totalPatients++;

        cout << "\nPatient registered successfully!\n";
    }


    // ========================================================
    // DISPLAY PATIENTS
    // ========================================================

    void displayPatients() {

        if (patientCount == 0) {
            cout << "\nNo patients registered.\n";
            return;
        }

        cout << "\n================ PATIENT LIST ================\n";

        cout << left
             << setw(8) << "ID"
             << setw(20) << "Name"
             << setw(8) << "Age"
             << setw(12) << "Gender"
             << setw(10) << "Level"
             << endl;

        cout << "----------------------------------------------------------\n";

        for (int i = 0; i < patientCount; i++) {
            patients[i].display();
        }
    }


    // ========================================================
    // REGISTER RESOURCE
    // ========================================================

    void registerResource() {

        if (resourceCount >= 50) {
            cout << "\nResource storage is full!\n";
            return;
        }

        int choice;

        cout << "\n========== RESOURCE REGISTRATION ==========\n";
        cout << "1. Ambulance\n";
        cout << "2. Emergency Bed\n";
        cout << "3. Medical Equipment\n";
        cout << "4. Response Team\n";
        cout << "Enter choice: ";
        cin >> choice;

        int id;

        cout << "Enter Resource ID: ";
        cin >> id;

        if (choice == 1) {

            string type;
            int capacity;

            cout << "Enter Ambulance Type: ";
            cin >> type;

            cout << "Enter Patient Capacity: ";
            cin >> capacity;

            resources[resourceCount] =
                new Ambulance(id, type, capacity);

        }

        else if (choice == 2) {

            string ward;
            int capacity;

            cout << "Enter Ward Type: ";
            cin >> ward;

            cout << "Enter Bed Capacity: ";
            cin >> capacity;

            resources[resourceCount] =
                new EmergencyBed(id, ward, capacity);
        }

        else if (choice == 3) {

            string equipment;
            int quantity;

            cout << "Enter Equipment Type: ";
            cin >> equipment;

            cout << "Enter Quantity: ";
            cin >> quantity;

            resources[resourceCount] =
                new MedicalEquipment(id, equipment, quantity);
        }

        else if (choice == 4) {

            string team;
            int members;
            string specialization;

            cout << "Enter Team Name: ";
            cin >> team;

            cout << "Enter Number of Members: ";
            cin >> members;

            cout << "Enter Specialization: ";
            cin >> specialization;

            resources[resourceCount] =
                new SpecializedResource(
                    id,
                    "Response Team",
                    team,
                    members,
                    specialization
                );
        }

        else {

            cout << "\nInvalid resource choice!\n";
            return;
        }

        resourceCount++;
        totalResources++;

        cout << "\nResource registered successfully!\n";
    }


    // ========================================================
    // DISPLAY RESOURCES
    // ========================================================

    void displayResources() {

        if (resourceCount == 0) {
            cout << "\nNo resources registered.\n";
            return;
        }

        cout << "\n================ RESOURCE LIST ================\n";

        cout << left
             << setw(10) << "ID"
             << setw(20) << "Resource"
             << setw(18) << "Type"
             << setw(10) << "Capacity"
             << setw(12) << "Status"
             << endl;

        cout << "-----------------------------------------------------------------\n";

        // Runtime polymorphism
        for (int i = 0; i < resourceCount; i++) {

            resources[i]->display();
        }
    }


    // ========================================================
    // CREATE EMERGENCY CASE
    // ========================================================

    void createCase() {

        if (caseCount >= 50) {
            cout << "\nCase storage is full!\n";
            return;
        }

        int id = caseCount + 1;

        cases[caseCount].input(id);

        caseCount++;
        activeCases++;

        cout << "\nEmergency case created successfully!\n";
    }


    // ========================================================
    // DISPLAY CASES
    // ========================================================

    void displayCases() {

        if (caseCount == 0) {
            cout << "\nNo emergency cases available.\n";
            return;
        }

        cout << "\n================ EMERGENCY CASES ================\n";

        cout << left
             << setw(8) << "Case"
             << setw(12) << "Patient"
             << setw(25) << "Problem"
             << setw(10) << "Priority"
             << setw(15) << "Status"
             << setw(12) << "Resource"
             << endl;

        cout << "-----------------------------------------------------------------------------\n";

        for (int i = 0; i < caseCount; i++) {

            cases[i].display();
        }
    }


    // ========================================================
    // ALLOCATE RESOURCE
    // ========================================================

    void allocateResource() {

        if (caseCount == 0) {
            cout << "\nNo emergency cases available.\n";
            return;
        }

        if (resourceCount == 0) {
            cout << "\nNo resources registered.\n";
            return;
        }

        int caseId;

        cout << "\nEnter Case ID: ";
        cin >> caseId;

        int caseIndex = -1;

        for (int i = 0; i < caseCount; i++) {

            if (cases[i].getCaseId() == caseId) {
                caseIndex = i;
                break;
            }
        }

        if (caseIndex == -1) {
            cout << "\nCase not found!\n";
            return;
        }

        if (cases[caseIndex].getStatus() == "Allocated") {

            cout << "\nResource already allocated!\n";
            return;
        }

        cout << "\nAvailable Resources:\n";

        for (int i = 0; i < resourceCount; i++) {

            if (resources[i]->isAvailable()) {

                resources[i]->display();
            }
        }

        int resourceId;

        cout << "\nEnter Resource ID to allocate: ";
        cin >> resourceId;

        int resourceIndex = -1;

        for (int i = 0; i < resourceCount; i++) {

            if (resources[i]->getId() == resourceId) {
                resourceIndex = i;
                break;
            }
        }

        if (resourceIndex == -1) {

            cout << "\nResource not found!\n";
            return;
        }

        if (!resources[resourceIndex]->isAvailable()) {

            cout << "\nResource is currently busy!\n";
            return;
        }

        resources[resourceIndex]->useResource();

        cases[caseIndex].allocateResource(resourceId);

        cout << "\nResource allocated successfully!\n";
    }


    // ========================================================
    // UPDATE RESOURCE
    // ========================================================

    void updateResource() {

        if (resourceCount == 0) {
            cout << "\nNo resources available.\n";
            return;
        }

        int id;

        cout << "\nEnter Resource ID: ";
        cin >> id;

        for (int i = 0; i < resourceCount; i++) {

            if (resources[i]->getId() == id) {

                int choice;

                cout << "\n1. Mark Available\n";
                cout << "2. Mark Busy\n";
                cout << "Enter choice: ";
                cin >> choice;

                if (choice == 1) {

                    resources[i]->releaseResource();

                    cout << "\nResource marked as AVAILABLE.\n";
                }

                else if (choice == 2) {

                    resources[i]->useResource();

                    cout << "\nResource marked as BUSY.\n";
                }

                else {

                    cout << "\nInvalid choice!\n";
                }

                return;
            }
        }

        cout << "\nResource not found!\n";
    }


    // ========================================================
    // COMPARE CASE PRIORITIES
    // ========================================================

    void compareCases() {

        if (caseCount < 2) {

            cout << "\nAt least two cases are required.\n";
            return;
        }

        int id1, id2;

        cout << "\nEnter First Case ID: ";
        cin >> id1;

        cout << "Enter Second Case ID: ";
        cin >> id2;

        int index1 = -1;
        int index2 = -1;

        for (int i = 0; i < caseCount; i++) {

            if (cases[i].getCaseId() == id1)
                index1 = i;

            if (cases[i].getCaseId() == id2)
                index2 = i;
        }

        if (index1 == -1 || index2 == -1) {

            cout << "\nInvalid case ID.\n";
            return;
        }

        // Operator overloading
        if (cases[index1] > cases[index2]) {

            cout << "\nCase " << id1
                 << " has HIGHER priority.\n";
        }

        else if (cases[index2] > cases[index1]) {

            cout << "\nCase " << id2
                 << " has HIGHER priority.\n";
        }

        else {

            cout << "\nBoth cases have SAME priority.\n";
        }
    }


    // ========================================================
    // RESOURCE UTILIZATION SCORE
    // ========================================================

    void utilizationScore() {

        if (resourceCount == 0) {

            cout << "\nNo resources available.\n";
            return;
        }

        int busy = 0;

        for (int i = 0; i < resourceCount; i++) {

            if (!resources[i]->isAvailable())
                busy++;
        }

        double score =
            ((double)busy / resourceCount) * 100;

        cout << fixed << setprecision(2);

        cout << "\n====================================\n";
        cout << " RESOURCE UTILIZATION SCORE\n";
        cout << "====================================\n";

        cout << "Total Resources : "
             << resourceCount << endl;

        cout << "Busy Resources  : "
             << busy << endl;

        cout << "Available       : "
             << resourceCount - busy << endl;

        cout << "Utilization     : "
             << score << "%\n";
    }


    // ========================================================
    // COMPLETE CASE
    // ========================================================

    void completeCase() {

        if (caseCount == 0) {

            cout << "\nNo cases available.\n";
            return;
        }

        int id;

        cout << "\nEnter Case ID to complete: ";
        cin >> id;

        for (int i = 0; i < caseCount; i++) {

            if (cases[i].getCaseId() == id) {

                if (cases[i].getStatus() != "Allocated") {

                    cout << "\nCase does not have an allocated resource.\n";
                    return;
                }

                int resourceId =
                    cases[i].getResourceId();

                for (int j = 0; j < resourceCount; j++) {

                    if (resources[j]->getId() == resourceId) {

                        resources[j]->releaseResource();
                        break;
                    }
                }

                cases[i].closeCase();

                activeCases--;

                cout << "\nEmergency case completed successfully!\n";

                return;
            }
        }

        cout << "\nCase not found!\n";
    }


