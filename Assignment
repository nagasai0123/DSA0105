    }

    Ambulance(int id, string type, int cap)
        : Resource(id, "Ambulance") {
        ambulanceType = type;
        capacity = cap;
    }

    void display() const override {
        cout << left
             << setw(10) << resourceId
             << setw(20) << resourceName
             << setw(18) << ambulanceType
             << setw(10) << capacity
             << setw(12) << (available ? "Available" : "Busy")
             << endl;
    }

    string getType() const override {
        return "Ambulance";
    }

    int getCapacity() const {
        return capacity;
    }
};


