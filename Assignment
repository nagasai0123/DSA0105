// ============================================================
// 1. PATIENT CLASS
// ============================================================

class Patient {
private:
    int patientId;
    string name;
    int age;
    string gender;
    int emergencyLevel;

public:
    // Default constructor
    Patient() {
        patientId = 0;
        name = "Unknown";
        age = 0;
        gender = "Unknown";
        emergencyLevel = 1;
    }

    // Parameterized constructor
    Patient(int id, string n, int a, string g, int level) {
        patientId = id;
        name = n;
        age = a;
        gender = g;
        emergencyLevel = level;
    }

    // Copy constructor
    Patient(const Patient &p) {
        patientId = p.patientId;
        name = p.name;
        age = p.age;
        gender = p.gender;
        emergencyLevel = p.emergencyLevel;
    }

    void input() {
        cout << "\nEnter Patient ID: ";
        cin >> patientId;

        cout << "Enter Patient Name: ";
        cin.ignore();
        getline(cin, name);

        cout << "Enter Age: ";
        cin >> age;

        cout << "Enter Gender: ";
        cin >> gender;

        cout << "Enter Emergency Level (1-5): ";
        cin >> emergencyLevel;

        if (emergencyLevel < 1)
            emergencyLevel = 1;

        if (emergencyLevel > 5)
            emergencyLevel = 5;
    }

    void display() const {
        cout << left
             << setw(8) << patientId
             << setw(20) << name
             << setw(8) << age
             << setw(12) << gender
             << setw(10) << emergencyLevel << endl;
    }

    int getId() const {
        return patientId;
    }

    int getEmergencyLevel() const {
        return emergencyLevel;
    }

    string getName() const {
        return name;
    }
};


// ============================================================
// 2. ABSTRACT RESOURCE CLASS
// ============================================================

class Resource {
protected:
    int resourceId;
    string resourceName;
    bool available;

public:

    Resource() {
        resourceId = 0;
        resourceName = "Unknown";
        available = true;
    }

    Resource(int id, string name) {
        resourceId = id;
        resourceName = name;
        available = true;
    }

    virtual void display() const = 0;

    virtual string getType() const = 0;

    virtual void useResource() {
        available = false;
    }

    virtual void releaseResource() {
        available = true;
    }

    bool isAvailable() const {
        return available;
    }

    int getId() const {
        return resourceId;
    }

    virtual ~Resource() {
        // Virtual destructor
    }
};


// ============================================================
// 3. AMBULANCE CLASS
// ============================================================

class Ambulance : public Resource {
private:
    string ambulanceType;
    int capacity;

public:

    Ambulance() : Resource() {
