#include <iostream>
using namespace std;

class RailwayTicket
{
    string name, coach;
    long mobno;
    int amt, totalamt;

public:
    void accept()
    {
        cout << "Enter name: ";
        cin >> name;

        cout << "Enter coach: ";
        cin >> coach;

        cout << "Enter mobile number: ";
        cin >> mobno;

        cout << "Enter basic amount: ";
        cin >> amt;
    }

    void update()
    {
        if(coach == "First_AC")
            totalamt = amt + 700;
        else if(coach == "Second_AC")
            totalamt = amt + 500;
        else if(coach == "Third_AC")
            totalamt = amt + 250;
        else
            totalamt = amt;
    }

    void display()
    {
        cout << "\nName: " << name;
        cout << "\nCoach: " << coach;
        cout << "\nMobile: " << mobno;
        cout << "\nTotal Amount: " << totalamt;
    }
};

int main()
{
    RailwayTicket r;
    r.accept();
    r.update();
    r.display();

    return 0;
}

