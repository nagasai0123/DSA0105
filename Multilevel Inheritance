#include <iostream>
using namespace std;

class Student
{
protected:
    int m1, m2, m3;

public:
    void accept()
    {
        cout << "Enter 3 subject marks: ";
        cin >> m1 >> m2 >> m3;
    }
};

class Total : public Student
{
protected:
    int total;

public:
    void calculateTotal()
    {
        total = m1 + m2 + m3;
    }
};

class Percentage : public Total
{
public:
    void calculatePercentage()
    {
        float p = total / 3.0;

        cout << "Total = " << total << endl;
        cout << "Percentage = " << p << "%";
    }
};

int main()
{
    Percentage p;

    p.accept();
    p.calculateTotal();
    p.calculatePercentage();

    return 0;
}

